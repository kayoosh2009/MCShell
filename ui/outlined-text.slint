import "fonts/Monocraft.otf";
import { Palette } from "palette.slint";

export component OutlinedText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 24px;
    in property <color> text-color: Palette.text-primary;
    in property <color> outline-color: Palette.accent;

    width: label.width;
    height: label.height;

    // 8 копий текста по кругу — имитация обводки
    Text { text: root.text; font-family: "Monocraft"; font-size: root.font-size; color: root.outline-color; x: -1px; y: -1px; }
    Text { text: root.text; font-family: "Monocraft"; font-size: root.font-size; color: root.outline-color; x: 0px;  y: -1px; }
    Text { text: root.text; font-family: "Monocraft"; font-size: root.font-size; color: root.outline-color; x: 1px;  y: -1px; }
    Text { text: root.text; font-family: "Monocraft"; font-size: root.font-size; color: root.outline-color; x: -1px; y: 0px;  }
    Text { text: root.text; font-family: "Monocraft"; font-size: root.font-size; color: root.outline-color; x: 1px;  y: 0px;  }
    Text { text: root.text; font-family: "Monocraft"; font-size: root.font-size; color: root.outline-color; x: -1px; y: 1px;  }
    Text { text: root.text; font-family: "Monocraft"; font-size: root.font-size; color: root.outline-color; x: 0px;  y: 1px;  }
    Text { text: root.text; font-family: "Monocraft"; font-size: root.font-size; color: root.outline-color; x: 1px;  y: 1px;  }

    // Основной текст сверху
    label := Text {
        text: root.text;
        font-family: "Monocraft";
        font-size: root.font-size;
        color: root.text-color;
    }
}