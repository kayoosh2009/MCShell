import { LineEdit, ComboBox, Button } from "std-widgets.slint";
import { Palette } from "palette.slint";
import { OutlinedText } from "outlined-text.slint";

export component MainWindow inherits Window {
    title: "MCShell";
    width: 926px;
    height: 652px;
    min-width: 926px;
    max-width: 926px;
    min-height: 652px;
    max-height: 652px;
    background: Palette.background;

    VerticalLayout {
        // ── Верх: галерея/превью скриншотов игры ──
        Rectangle {
            height: 480px;
            clip: true;
            background: #1a1a1a; // заглушка, пока нет фото

            Image {
                // TODO: положи скриншот в ui/images/preview.png и раскомментируй
                // source: @image-url("images/preview.png");
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
        }

        // ── Низ: панель управления ──
        Rectangle {
            height: 172px;
            background: Palette.background;

            HorizontalLayout {
                padding: 16px;
                spacing: 12px;

                // Никнейм
                VerticalLayout {
                    spacing: 4px;
                    alignment: center;
                    OutlinedText { text: "Username"; font-size: 12px; }
                    LineEdit {
                        placeholder-text: "Steve";
                        width: 180px;
                    }
                }

                // Версия (пока заглушка выбора)
                VerticalLayout {
                    spacing: 4px;
                    alignment: center;
                    OutlinedText { text: "Version"; font-size: 12px; }
                    ComboBox {
                        model: ["Latest"];
                        width: 140px;
                    }
                }

                // Квадратная кнопка со скином (иконку добавишь сам)
                VerticalLayout {
                    alignment: center;
                    Button {
                        width: 48px;
                        height: 48px;
                        text: "";
                    }
                }

                // Пустота — растягивается, отодвигая Play вправо
                Rectangle {
                    horizontal-stretch: 1;
                }

                // Кнопка играть
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "PLAY";
                        width: 140px;
                        height: 48px;
                    }
                }
            }
        }
    }
}