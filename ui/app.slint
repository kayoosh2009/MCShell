import { ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct ModItem {
    name: string,
    enabled: bool,
}

export struct VersionItem {
    id: string,
    kind: string,
}

export struct JavaItem {
    major: int,
    installed: bool,
    note: string,
}

export struct KeyValueItem {
    label: string,
    value: string,
}

export struct CrashFinding {
    msg: string,
    detail: string,
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 36px;
    border-radius: 6px;
    background: active ? #ffffff : (touch.has-hover ? #ffffff18 : transparent);
    border-width: active ? 0px : 1px;
    border-color: touch.has-hover ? #ffffff25 : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: label;
        color: active ? #0d1011 : #e5e7eb;
        font-size: 13px;
        font-weight: active ? 700 : 500;
        x: 12px;
        vertical-alignment: center;
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked();

    height: 32px;
    min-width: 80px;
    border-radius: 6px;
    background: danger ? (touch.has-hover ? #7f1d1d : #450a0a)
              : primary ? (touch.has-hover ? #e5e7eb : #ffffff)
              : (touch.has-hover ? #ffffff22 : #ffffff12);
    border-width: 1px;
    border-color: danger ? #ef4444 : (primary ? #ffffff : #ffffff28);

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;

        if icon.width > 0 : Image {
            source: icon;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            colorize: primary ? #0d1011 : #ffffff;
        }

        Text {
            text: label;
            color: primary ? #0d1011 : (danger ? #fca5a5 : #ffffff);
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    callback toggled();

    height: 38px;
    border-radius: 6px;
    background: touch.has-hover ? #1c212b : #161b22;

    touch := TouchArea {
        clicked => { root.toggled(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        Rectangle {
            width: 18px;
            height: 18px;
            y: 10px;
            border-radius: 4px;
            background: checked ? #22c55e : transparent;
            border-width: 1.5px;
            border-color: checked ? #22c55e : #6e7681;

            if checked : Text {
                text: "✓";
                color: #07130b;
                font-size: 12px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: label;
            color: #e6edf3;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "MCShell";
    preferred-width: 960px;
    preferred-height: 620px;
    min-width: 780px;
    min-height: 500px;
    background: #0d1011;

    in property <image> bg-image;
    in-out property <string> selected-version: "";
    in-out property <int> active-tab: 0;
    in-out property <int> more-page: 0;
    in property <string> status: "Ready";
    in property <[string]> progress-log: [];

    // Profile & Stats
    in-out property <string> username: "";
    in property <string> uuid: "";
    in property <[KeyValueItem]> playing-stats: [];
    in property <[KeyValueItem]> storage-stats: [];

    // Versions & Launch
    in property <[string]> installed-versions: [];
    in property <[VersionItem]> remote-versions: [];

    // Content lists
    in property <[ModItem]> mods: [];
    in property <[string]> packs: [];
    in property <[string]> worlds: [];

    // Skins
    in property <bool> has-skin: false;
    in property <image> skin-preview;

    // Settings & Java & About
    in property <bool> discord-on: false;
    in property <bool> hide-after-launch: false;
    in property <bool> show-logs-separate: false;
    in property <[JavaItem]> java-list: [];
    in property <string> about-github: "";
    in property <string> about-email: "";
    in property <string> about-discord: "";
    in property <string> about-telegram: "";

    // Overlays
    in property <int> browse-seconds: 0;
    in property <bool> crash-visible: false;
    in property <string> crash-version: "";
    in property <string> crash-code: "";
    in property <[CrashFinding]> crash-findings: [];
    in property <[KeyValueItem]> crash-files: [];
    in property <string> crash-tail-name: "";
    in property <string> crash-tail-text: "";

    // Callbacks
    callback tab-changed(int);
    callback save-username(string);
    callback fetch-versions();
    callback install-version(string);
    callback install-fabric(string);
    callback delete-version(string);
    callback launch-version(string);
    callback toggle-mod(int);
    callback delete-mod(int);
    callback open-mods-folder();
    callback browse-online();
    callback delete-pack(int);
    callback open-packs-folder();
    callback export-world(int);
    callback open-worlds-folder();
    callback toggle-setting(int);
    callback install-java(int);
    callback remove-java(int);
    callback open-link(string);
    callback cancel-browse();
    callback close-crash();
    callback open-logs-folder();
    callback open-crash-file();

    // Фоновое фото + затемнение
    Image {
        source: root.bg-image;
        image-fit: cover;
        width: 100%;
        height: 100%;
    }
    Rectangle {
        background: #0d101180;
        width: 100%;
        height: 100%;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;

        HorizontalLayout {
            vertical-stretch: 1;

            // Main content area
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;
                    alignment: start;

                    // 0: Main
                    if active-tab == 0 : HorizontalLayout {
                        spacing: 12px;

                        // Updates 1.0.17
                        Rectangle {
                            background: #0d1011cc;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #ffffff20;
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                alignment: start;
                                Text { text: "Updates 1.0.17"; color: #ffffff; font-size: 14px; font-weight: 700; }
                                Text {
                                    text: "• New native Slint GUI\n• Monochrome #0d1011 theme\n• Blurred background & stats";
                                    color: #9ca3af;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Playing stats
                        Rectangle {
                            background: #0d1011cc;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #ffffff20;
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                alignment: start;
                                Text { text: "Playing"; color: #ffffff; font-size: 14px; font-weight: 700; }
                                for item in playing-stats : HorizontalLayout {
                                    Text { text: item.label; color: #9ca3af; width: 95px; font-size: 12px; }
                                    Text { text: item.value; color: #ffffff; font-size: 12px; }
                                }
                            }
                        }

                        // Storage stats
                        Rectangle {
                            background: #0d1011cc;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #ffffff20;
                            horizontal-stretch: 1;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                alignment: start;
                                Text { text: "Storage"; color: #ffffff; font-size: 14px; font-weight: 700; }
                                for item in storage-stats : HorizontalLayout {
                                    Text { text: item.label; color: #9ca3af; width: 100px; font-size: 12px; }
                                    Text { text: item.value; color: #ffffff; font-size: 12px; }
                                }
                            }
                        }
                    }
                }
            }

            // Right Sidebar
            Rectangle {
                width: 160px;
                background: #0d1011cc;
                border-width: 1px;
                border-color: #ffffff1a;

                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    alignment: start;

                    NavButton { label: "Main"; active: active-tab == 0; clicked => { active-tab = 0; tab-changed(0); } }
                }
            }
        }

        // Bottom bar: nickname, game version, play
        Rectangle {
            height: 62px;
            background: #0d1011e6;
            border-width: 1px;
            border-color: #ffffff1a;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;

                name-input := LineEdit {
                    text: root.username;
                    placeholder-text: "Nickname";
                    width: 200px;
                    height: 36px;
                    y: (parent.height - self.height) / 2;
                    accepted(t) => { root.save-username(t); }
                }

                ver-box := ComboBox {
                    width: 220px;
                    height: 36px;
                    y: (parent.height - self.height) / 2;
                    model: root.installed-versions;
                    current-value <=> root.selected-version;
                }

                Rectangle { horizontal-stretch: 1; }

                ActionButton {
                    label: "Play";
                    icon: @image-url("icons/play.png");
                    primary: true;
                    width: 130px;
                    height: 36px;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.save-username(name-input.text);
                        root.launch-version(ver-box.current-value);
                    }
                }
            }
        }
    }
}